type Query {
    account(id: ID!): Account!
    accounts: [Account!]!
}

type Mutation {
    createAccount(customerReference: String!, currency: String!, balance: Float!): Account!
    changeAccountStatus(id: ID!, status: AccountStatus!): Account!
    adjustAccountBalance(id: ID!, change: Float!): Account!
}

type Account {
    id: ID!
    customerReference: String!
    status: AccountStatus!
    currency: String!
    balance: Float!
}

enum AccountStatus {
    ACTIVE
    BLOCKED
}
